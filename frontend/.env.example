# The frontend now talks to a single api-gateway instance, which
# routes to all five backend services internally. You normally only
# need to set this one variable.
VITE_GATEWAY_URL=http://localhost:8087

# The individual service URLs below are NOT used by the app anymore
# (api/client.js points everything at VITE_GATEWAY_URL) — kept here
# only as a reference if you ever want to bypass the gateway for
# debugging a specific service directly.
# VITE_USER_SERVICE_URL=http://localhost:8082
# VITE_VEHICLE_SERVICE_URL=http://localhost:8086
# VITE_BOOKING_SERVICE_URL=http://localhost:8083
# VITE_PAYMENT_SERVICE_URL=http://localhost:8084
# VITE_REVIEW_SERVICE_URL=http://localhost:8085
